{
  "manifest_version": 3,
  "name": "Zotero to Gemini Notebook",
  "version": "0.3.4",
  "description": "Import staged Zotero sources into Gemini Notebook",
  "permissions": ["activeTab"],
  "host_permissions": [
    "http://127.0.0.1:23119/*",
    "https://notebook.google.com/*",
    "https://notebooklm.google.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://notebook.google.com/*",
        "https://notebooklm.google.com/*"
      ],
      "js": [
        "upload-transfer.js",
        "upload-handoff.js",
        "dialog-upload-status.js",
        "gemini-controls.js",
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://notebook.google.com/*",
        "https://notebooklm.google.com/*"
      ],
      "js": ["injector.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}

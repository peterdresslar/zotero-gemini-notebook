{
  "name": "zotero-gemini-notebook",
  "type": "module",
  "version": "0.5.0",
  "description": "Export Zotero items to Gemini Notebook (formerly NotebookLM)",
  "config": {
    "addonName": "Zotero Gemini Notebook",
    "addonID": "zotero-notebooklm@peterdresslar.com",
    "addonRef": "zoteroNotebookLM",
    "addonInstance": "ZoteroNotebookLM",
    "prefsPrefix": "extensions.zotero.zoteroNotebookLM"
  },
  "companionCompatibility": {
    "validVersions": [
      "0.4.0",
      "0.4.1",
      "0.5.0"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/peterdresslar/zotero-gemini-notebook.git"
  },
  "author": "peterdresslar",
  "bugs": {
    "url": "https://github.com/peterdresslar/zotero-gemini-notebook/issues"
  },
  "homepage": "https://github.com/peterdresslar/zotero-gemini-notebook#readme",
  "license": "MIT",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "zotero-plugin serve",
    "build": "zotero-plugin build && tsc --noEmit",
    "lint:check": "prettier --check . && eslint .",
    "lint:fix": "prettier --write . && eslint . --fix",
    "mcp:setup": "uv sync --project mcp-adapter --locked",
    "mcp:status": "uv run --project mcp-adapter --locked fastmcp call mcp-adapter/server.py get_zotero_bridge_status --json",
    "package:chrome": "mkdir -p .scaffold/build && rm -f .scaffold/build/zotero-gemini-notebook-chrome-extension.zip && cd chrome-extension && zip -qr ../.scaffold/build/zotero-gemini-notebook-chrome-extension.zip .",
    "package:release": "pnpm run build && pnpm run package:chrome && pnpm run release:check",
    "release:check": "pnpm run test:release && node scripts/validate-release.mjs",
    "release:promote": "node scripts/promote-release.mjs",
    "release:verify-published": "node scripts/validate-release.mjs --published",
    "test": "zotero-plugin test",
    "test:mcp": "uv run --project mcp-adapter --locked python -m unittest discover -s mcp-adapter/tests -v",
    "test:release": "node --test scripts/*.test.mjs",
    "update-deps": "pnpm update"
  },
  "dependencies": {
    "zotero-plugin-toolkit": "^6.0.0"
  },
  "devDependencies": {
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.19.2",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@zotero-plugin/eslint-config": "^0.6.10",
    "chai": "^6.3.0",
    "epubjs": "https://codeload.github.com/zotero/epub.js/tar.gz/a6139d586b66d404f3da2b846598960c0394afc5",
    "eslint": "^10.12.0",
    "mocha": "^12.0.3",
    "pdfjs-dist": "https://codeload.github.com/zotero-plugin-dev/zotero-pdfjs-types/tar.gz/11aa3606ba5415118d45b86c257d4055a1d4e666",
    "prettier": "^3.9.10",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "zotero-plugin-scaffold": "^0.9.2",
    "zotero-types": "^4.1.3"
  },
  "prettier": {
    "printWidth": 80,
    "tabWidth": 2,
    "endOfLine": "lf",
    "overrides": [
      {
        "files": [
          "*.xhtml"
        ],
        "options": {
          "htmlWhitespaceSensitivity": "css"
        }
      },
      {
        "files": [
          "*.svg"
        ],
        "options": {
          "parser": "html"
        }
      }
    ]
  }
}
